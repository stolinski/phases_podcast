{
  "phasesDir": "~/Documents/phases",
  "inboxDir": "upnext",
  "episodesDir": "episodes",
  "episodeFolderName": "{prefix}{next}",
  "settleSeconds": 30,
  "pollSeconds": 5,
  "idleExitSeconds": 120,
  "maxWaitMinutes": 180,
  "allowExtraFiles": true,
  "requiredMedia": [
    {
      "id": "courtney",
      "label": "Dr. Courtney's track",
      "match": ["*courtney*"],
      "extensions": ["wav", "aif", "aiff", "flac", "m4a", "mp3", "mov", "mp4", "m4v", "mkv"],
      "min": 1
    },
    {
      "id": "scott",
      "label": "Scott's track",
      "match": ["*scott*"],
      "extensions": ["wav", "aif", "aiff", "flac", "m4a", "mp3", "mov", "mp4", "m4v", "mkv"],
      "min": 1
    }
  ],
  "probe": true,
  "notify": true,
  "resolve": {
    "enabled": true,
    "required": true,
    "appName": "DaVinci Resolve",
    "processName": "Resolve",
    "launchTimeoutSeconds": 120,
    "readyDelaySeconds": 20
  },
  "claude": {
    "bin": "claude",
    "skill": null,
    "promptTemplate": "./prompt.md",
    "permissionMode": "acceptEdits",
    "allowedTools": [],
    "model": null,
    "effort": null,
    "maxBudgetUsd": null,
    "extraArgs": []
  }
}
